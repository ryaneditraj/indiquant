# Copy to .env and fill in values. Never commit real secrets.

# --- App / brand ---
QUANT_OS_ENV=development
# QUANT_OS_ENV=production  # disables local crypto helper endpoints
QUANT_OS_CONFIG_PATH=./config.yaml

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://moneyradar.in,https://www.moneyradar.in

# --- Web (browser-visible; no secrets) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Indiquant
NEXT_PUBLIC_PARENT_BRAND=Money Radar
NEXT_PUBLIC_PARENT_URL=https://moneyradar.in
NEXT_PUBLIC_ORG_NAME=Thugir Group
NEXT_PUBLIC_SITE_URL=https://moneyradar.in/indiquant

# --- Database ---
# SQLite works out of the box for local research. Swap to Postgres for multi-user.
DATABASE_URL=sqlite:///./data/quant_os.db
# DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/indiquant

# Local Docker Compose only. `quant` is a development default committed for
# zero-config startup. Change it before publishing port 5432 beyond localhost.
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant
POSTGRES_DB=quant_os

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI providers (OpenAI-compatible) ---
AI_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
AI_OPENAI_COMPATIBLE_API_KEY=
AI_DEFAULT_PROVIDER=openai_compatible
AI_DEFAULT_MODEL=gpt-4o-mini

AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_API_KEY=

# --- Data providers ---
DATA_NSE_API_BASE_URL=
DATA_NSE_API_KEY=
DATA_BSE_API_BASE_URL=
DATA_BSE_API_KEY=
DATA_CSV_ROOT=data/sample_csv

# --- Google Trends (optional live; default is fixture in config.yaml) ---
# pip install 'quant-os-api[trends]'  # or: pip install pytrends
# GOOGLE_TRENDS_PROVIDER=fixture
# Weekly pulls: celery beat (quant_os.trends_collect_all) OR make trends-collect-all / scripts/trends_weekly.sh
# TRENDS_PROVIDER=fixture

# --- Security ---
# Must be a long random string before any networked / multi-user deploy.
SECRET_KEY=change-me-to-a-long-random-string
# Optional Fernet material for local encrypt helpers. Leave empty to skip.
# /api/v1/security/encrypt and /decrypt are disabled when QUANT_OS_ENV=production.
ENCRYPTION_KEY=
