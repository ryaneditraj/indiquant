# Copy to .env and fill in values. Never commit real secrets.

# --- App ---
QUANT_OS_ENV=development
QUANT_OS_CONFIG_PATH=./config.yaml

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Web (browser-visible; no secrets) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Pramana

# --- Database ---
# SQLite works out of the box for local research. Swap to Postgres for multi-user.
DATABASE_URL=sqlite:///./data/quant_os.db
# DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant_os

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI providers (OpenAI-compatible) ---
AI_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
AI_OPENAI_COMPATIBLE_API_KEY=
AI_DEFAULT_PROVIDER=openai_compatible
AI_DEFAULT_MODEL=gpt-4o-mini

# Local / Ollama-style (optional)
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_API_KEY=

# --- Data providers (adapter-specific; leave blank until needed) ---
DATA_NSE_API_BASE_URL=
DATA_NSE_API_KEY=
DATA_BSE_API_BASE_URL=
DATA_BSE_API_KEY=
DATA_CSV_ROOT=data/sample_csv

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=
